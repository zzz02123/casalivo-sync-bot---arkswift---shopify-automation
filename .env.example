# ========================================================
# Casalivo Sync Bot - 环境变量模板 (.env.example)
# 复制此文件为 .env 并填入你的真实凭证
# ========================================================

# Gemini API 配置
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# --------------------------------------------------------
# 接口凭据 (Client ID / Client Secret 或 RSA 密钥对)
# --------------------------------------------------------
CLIENT_ID="your_client_id_or_public_key_here"
CLIENT_SECRET="your_client_secret_or_private_key_here"

# --------------------------------------------------------
# ArkSwift 开放平台参数别名映射
# --------------------------------------------------------
ARKSWIFT_API_URL="https://api.arkswift.com"
ARKSWIFT_APP_KEY="your_arkswift_app_key"
ARKSWIFT_APP_SECRET="your_arkswift_app_secret"
ARKSWIFT_SELLER_ID=""

# --------------------------------------------------------
# Shopify 店铺凭据配置
# --------------------------------------------------------

# --------------------------------------------------------
# Shopify Admin API — Client Credentials Grant (OAuth 2.0)
# Dev Dashboard → 你的应用 → Client ID / Client secret
# 前端不接触这两个值；服务端换票后仅在内存缓存（24h，提前 5 分钟续期）
# --------------------------------------------------------
SHOPIFY_SHOP_DOMAIN="casalivo.myshopify.com"
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_API_VERSION="2025-07"
# 已废弃：手动 shpat_ 令牌，仅本地调试兜底，正常流程请留空
# SHOPIFY_ACCESS_TOKEN=
SHOPIFY_LOCATION_ID=""
# Storefront API：只读公开令牌，仅用于独立站前端展示，绝不用于 Admin 写操作
SHOPIFY_STOREFRONT_TOKEN="your_storefront_access_token_here"
